{
  "devDependencies": {
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/cucumber-framework": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "allure-commandline": "^2.46.1",
    "wdio-video-reporter": "^6.2.0"
  },
  "name": "examenpruebaroy",
  "version": "1.0.0",
  "description": "Resolución del examen de automatización sobre Hotel QA (https://hotel-qa-f51.pages.dev/).",
  "scripts": {
    "clean": "node -e \"['allure-results','allure-report','videos'].forEach(d => require('fs').rmSync(d, { recursive: true, force: true }))\"",
    "test": "wdio run ./wdio.conf.js",
    "wdio": "wdio run ./wdio.conf.js",
    "test:bugs": "wdio run ./wdio.conf.js --cucumberOpts.tags=@bug",
    "test:evidencias": "wdio run ./wdio.devtools.conf.js",
    "allure:generate": "node scripts/allure-report.js",
    "allure:open": "allure open allure-report",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianZamorano/examenPruebaRoy.git"
  },
  "keywords": [],
